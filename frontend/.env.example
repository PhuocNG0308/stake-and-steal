# Stake and Steal - Environment Variables Template
# Copy this file to .env.local and fill in the values

# Network: 'local' for development, 'testnet' for Linera testnet Conway
VITE_NETWORK=local

# Application ID (get this after deploying the contract)
# Run: .\scripts\deploy-testnet.ps1
VITE_APP_ID=

# Use mock data (set to 'false' to connect to real Linera node)
VITE_USE_MOCK=true
