# Stake and Steal - Linera Testnet Conway Configuration

# Testnet Conway endpoints (Current active testnet)
LINERA_FAUCET_URL=https://faucet.testnet-conway.linera.net
LINERA_RPC_URL=https://rpc.testnet-conway.linera.net
LINERA_EXPLORER_URL=https://explorer.testnet-conway.linera.net

# Local service port
LINERA_SERVICE_PORT=8080

# Frontend GraphQL endpoint (when service is running)
VITE_LINERA_ENDPOINT=http://localhost:8080

# Application settings
INITIAL_BALANCE=1000
